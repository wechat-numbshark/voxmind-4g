+        return;
+    }
+    power_status_t b;
+    struct timeval tv;
+    gettimeofday(&tv, NULL);
+    double hours = (double)(tv.tv_sec - r.at_s) / 3600.0;
+    if (power_read(&b) != ESP_OK || hours <= 0.0 || hours > 24.0 * 120) return;
