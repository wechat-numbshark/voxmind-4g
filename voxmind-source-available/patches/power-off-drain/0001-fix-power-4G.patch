+    }
+    off_record_t r = s_off_rec;
+    s_off_rec.magic = 0;
+    bool from_sleep = esp_reset_reason() == ESP_RST_DEEPSLEEP;
+    if (r.magic != OFF_REC_MAGIC || r.check != off_rec_check(&r)) {
+        /* 记录没了：RTC 断过电。不是从深睡醒来（POWERON）且电量计也重置了，基本就是关机期间被放空了 */
+        if (!from_sleep && reset)
