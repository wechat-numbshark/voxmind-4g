# Claude —— 意图抽取。留空则用 `ant auth login` 的本地凭据
ANTHROPIC_API_KEY=

# 飞书自建应用
LARK_APP_ID=
LARK_APP_SECRET=
LARK_ENCRYPT_KEY=
LARK_VERIFICATION_TOKEN=

# MQTT —— 推卡片到设备
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# ASR 供应商：aliyun | tencent | xfyun
ASR_PROVIDER=
ASR_APP_KEY=
ASR_ACCESS_KEY_ID=
ASR_ACCESS_KEY_SECRET=

PORT=

# EVA 农场核心。IoT/能源/农事动作统一交给 EVA，不让模型直连 Home Assistant。
EVA_BASE_URL=
EVA_API_KEY=
EVA_SITE_ID=
# 可只把 EVA/智能家居切到 live，而让 EXECUTION_MODE 继续保持 mock。
EVA_EXECUTION_MODE=
# 非敏感设备别名/命令提示，供语音意图模型把自然语言映射到 EVA ID；不要放令牌。
EVA_DEVICE_HINTS=
